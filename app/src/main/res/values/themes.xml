<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de arranque (androidx.core.splashscreen): el logo animado va directo sobre el
         fondo Background/BackgroundDark, sin chip de color — el logo ya trae los suyos. -->
    <style name="Theme.Equilibrio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>
</resources>
